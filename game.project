[project]
title = Space game v.0.4
publisher = Асеев Кирилл
developer = Асеев Кирилл
version = v.0.4

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1280
height = 720

[physics]
scale = 0.02

[script]
shared_state = 1

[ios]
app_icon_76x76 = /spaceship/spaceship_00.png
app_icon_120x120 = /spaceship/spaceship_00.png
app_icon_152x152 = /background/ring_planet.png
app_icon_167x167 = /background/ring_planet.png
app_icon_180x180 = /background/ring_planet.png

[windows]
app_icon = /star.ico

[android]
app_icon_36x36 = /background/ring_planet.png
app_icon_48x48 = /background/ring_planet.png
app_icon_72x72 = /background/ring_planet.png
app_icon_96x96 = /background/ring_planet.png
app_icon_144x144 = /background/ring_planet.png
app_icon_192x192 = /background/ring_planet.png

